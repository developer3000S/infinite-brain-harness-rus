# Brains mounted under brains/ are independent git repos, cloned in by /start, never tracked.
brains/*
!brains/README.md

# Registry-root children (secondary use) are independent repos, known only via repo-registry/.
internal/*
!internal/README.md
external/*
!external/README.md

# Local per-machine config and runtime state.
.claude/brains.conf
.claude/settings.local.json
.claude/CLAUDE.local.md
.claude/mcp-servers.json
.qwen/brains.conf
.qwen/settings.local.json
.qwen/QWEN.local.md
.qwen/mcp-servers.json

# Generated runtime layer: the copied command layer and the capability index, regenerated by /sync.
.claude/.copied-manifest
.claude/COPIED-FROM.md
.claude/CAPABILITIES.md
.claude/agents/
.claude/skills/
.claude/rules/
.claude/commands/*
!.claude/commands/start.md
!.claude/commands/sync.md
!.claude/commands/save.md
!.claude/commands/promote-to-department.md
!.claude/commands/workspace-help.md
!.claude/commands/register-repo.md

# Generated runtime layer for Qwen Code: the copied command layer and the capability index, regenerated by /sync.
.qwen/.copied-manifest
.qwen/COPIED-FROM.md
.qwen/CAPABILITIES.md
.qwen/agents/
.qwen/skills/
.qwen/rules/
.qwen/commands/*
!.qwen/commands/start.md
!.qwen/commands/sync.md
!.qwen/commands/save.md
!.qwen/commands/promote-to-department.md
!.qwen/commands/workspace-help.md
!.qwen/commands/register-repo.md

# OS noise.
.DS_Store
Thumbs.db
